---
import Layout from '../layouts/Layout.astro';
---
<Layout>
	<!-- Introduction -->
	<section class="mt-8 text-zinc-300">
		<p class="text-xl font-medium text-zinc-100">
			Hey there!
		</p>
		<div class="mt-6 space-y-4 leading-relaxed text-lg">
			<p>
				I'm a software engineer, currently working at <a href="https://zulip.com/" target="_blank" class="text-blue-400 font-medium hover:underline decoration-2 underline-offset-4">Zulip</a>.
			</p>
			<p>
				All the code I write at Zulip is open source, and my work - including <a href="https://github.com/zulip/zulip/pulls?q=is%3Apr+author%3Aprakhar1144+is%3Amerged" target="_blank" class="text-blue-400 font-medium hover:underline decoration-2 underline-offset-4">pull requests</a>,
				<a href="https://github.com/zulip/zulip/commits?author=prakhar1144" target="_blank" class="text-blue-400 font-medium hover:underline decoration-2 underline-offset-4">commits</a>, and code reviews - is publicly accessible 🎉.
			</p>
		</div>

		<div class="mt-4 flex flex-wrap gap-4 text-zinc-400 text-sm">
			<span>AFK :</span>
			<a href="/bookshelf" class="text-blue-400 font-medium hover:underline decoration-2 underline-offset-4">Bookshelf</a>
			<!-- <a href="/travel" class="text-blue-400 font-medium hover:underline decoration-2 underline-offset-4">Travel</a> -->
			<!-- <a href="/ice-cream" class="text-blue-400 font-medium hover:underline decoration-2 underline-offset-4">Ice cream</a> -->
		</div>

		<div class="mt-8 flex flex-wrap gap-4 text-zinc-400 text-sm">
			<a href="mailto:prakhar1144@gmail.com" class="hover:text-zinc-100 transition-colors">Email</a>
			<span>/</span>
			<a href="https://www.linkedin.com/in/prakhar1144/" target="_blank" class="hover:text-zinc-100 transition-colors">LinkedIn</a>
			<span>/</span>
			<a href="https://github.com/prakhar1144" target="_blank" class="hover:text-zinc-100 transition-colors">GitHub</a>
			<span>/</span>
			<a href="https://stackoverflow.com/users/14264497/prakhar" target="_blank" class="hover:text-zinc-100 transition-colors">StackOverflow</a>
		</div>
	</section>
	<!-- Open source work -->
	<section class="mt-20">
		<h2 class="text-2xl font-bold tracking-tight text-zinc-100">Open source contributions</h2>
		<ul class="mt-8 space-y-4 text-zinc-300">
			<li class="flex items-baseline space-x-3">
				<span class="w-1.5 h-1.5 rounded-full bg-blue-500 mt-2 shrink-0"></span>
				<span class="flex flex-wrap items-baseline gap-x-2">
					<a href="https://github.com/zulip/zulip" class="font-mono text-[0.95rem] px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-100 hover:text-blue-400 transition-colors">
						<span class="opacity-50">zulip/</span>zulip
					</a> 
					<span class="text-zinc-500">—</span>
					<a href="https://github.com/zulip/zulip/pulls?q=is%3Apr+author%3Aprakhar1144+is%3Amerged" target="_blank" class="text-blue-400 hover:underline underline-offset-4 font-medium">pull requests</a>
				</span>
			</li>
			<li class="flex items-baseline space-x-3">
				<span class="w-1.5 h-1.5 rounded-full bg-blue-500 mt-2 shrink-0"></span>
				<span class="flex flex-wrap items-baseline gap-x-2">
					<a href="https://github.com/astral-sh/ruff" class="font-mono text-[0.95rem] px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-100 hover:text-blue-400 transition-colors">
						<span class="opacity-50">astral-sh/</span>ruff
					</a> 
					<span class="text-zinc-500">—</span>
					<a href="https://github.com/astral-sh/ruff/pulls?q=is%3Apr+author%3Aprakhar1144+is%3Amerged%2Fopen+sort%3Acreated-asc+" target="_blank" class="text-blue-400 hover:underline underline-offset-4 font-medium">pull requests</a>
				</span>
			</li>
			<li class="flex items-baseline space-x-3">
				<span class="w-1.5 h-1.5 rounded-full bg-blue-500  mt-2 shrink-0"></span>
				<span class="flex flex-wrap items-baseline gap-x-2">
					<a href="https://github.com/knadh/dns.toys" class="font-mono text-[0.95rem] px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-100 hover:text-blue-400 transition-colors">
						<span class="opacity-50">knadh/</span>dns.toys
					</a> 
					<span class="text-zinc-500">—</span>
					<a href="https://github.com/knadh/dns.toys/pulls?q=is%3Apr+author%3Aprakhar1144+is%3Aclosed" target="_blank" class="text-blue-400 hover:underline underline-offset-4 font-medium">pull requests</a>
				</span>
			</li>
			<li class="flex items-baseline space-x-3">
				<span class="w-1.5 h-1.5 rounded-full bg-blue-500 mt-2 shrink-0"></span>
				<span>
					Contributor <span class="text-zinc-500">—</span> Google Summer of Code <a href="https://summerofcode.withgoogle.com/archive/2023/projects/ijktWPlO" target="_blank" class="text-blue-400 hover:underline underline-offset-4 font-medium">2023</a>
				</span>
			</li>
			<li class="flex items-baseline space-x-3">
				<span class="w-1.5 h-1.5 rounded-full bg-blue-500 mt-2 shrink-0"></span>
				<span>
					Mentor <span class="text-zinc-500">—</span> Google Summer of Code <a href="https://summerofcode.withgoogle.com/archive/2024/projects/WQ3Wm0mo" target="_blank" class="text-blue-400 hover:underline underline-offset-4 font-medium">2024</a> & 2025
				</span>
			</li>
		</ul>
	</section>
	<!-- Projects -->
	<section class="mt-20">
		<h2 class="text-2xl font-bold tracking-tight text-zinc-100">Projects</h2>
		
		<article class="mt-10 group">
			<h3 class="text-lg font-semibold tracking-tight text-zinc-100 group-hover:text-blue-400 transition-colors">End-to-End Encryption for Mobile Push Notifications</h3>
			<div class="mt-4 text-zinc-300 leading-relaxed">
				<p>Implemented end-to-end encryption for mobile push notifications.</p>
				<ul class="mt-4 space-y-3">
					<li class="flex items-baseline space-x-3">
						<span class="text-blue-500 font-bold leading-none mr-2">•</span>
						<span>
							Several self-hosted orgs were <a href="https://github.com/zulip/zulip/issues/6954#issuecomment-2634131457" target="_blank" class="text-blue-400 hover:underline underline-offset-4">unable to adopt</a> Zulip
							due to their data protection policies, which required E2EE notifications.
						</span>
					</li>
					<li class="flex items-baseline space-x-3">
						<span class="text-blue-500 font-bold leading-none mr-2">•</span>
						<span>
							Used symmetric cryptography across a complex setup - mobile apps, self-hosted servers, cloud server, push service, and FCM/APNs - all working together.
						</span>
					</li>
				</ul>
			</div>
		</article>
		<article class="mt-12 group">
			<h3 class="text-lg font-semibold tracking-tight text-zinc-100 group-hover:text-blue-400 transition-colors">The Favourite One - "Follow Topics"</h3>
			<div class="mt-4 text-zinc-300 leading-relaxed">
				<p>Implemented a core piece of Zulip's notification subsystem.</p>
				<ul class="mt-4 space-y-3">
					<li class="flex items-baseline space-x-3">
						<span class="text-blue-500 font-bold leading-none mr-2">•</span>
						<span>
							Got a <a href="https://rust-lang.zulipchat.com/#narrow/channel/122653-zulip/topic/.22Follow.20Topic.22.20feature/near/399772355" target="_blank" class="text-blue-400 hover:underline underline-offset-4">shoutout in the Rust community</a>, which felt amazing
							as an undergrad to see my work being useful to folks building something as cool as the Rust programming language :)
						</span>
					</li>
					<li class="flex items-baseline space-x-3">
						<span class="text-blue-500 font-bold leading-none mr-2">•</span>
						<span>
							It was the first time I worked on such a long, engineering-heavy project. The whole thing spanned 7-8 months and involved tons of product and technical discussions.
						</span>
					</li>
					<li class="flex items-baseline space-x-3">
						<span class="text-blue-500 font-bold leading-none mr-2">•</span>
						<span>
							Helped me grow from open source newbie to full-time offer at Zulip.
						</span>
					</li>
				</ul>
			</div>
		</article>
	</section>
	<!-- Latest posts -->
	<section class="mt-20">
		<div class="flex items-center justify-between border-b border-zinc-800 pb-4">
			<h2 class="text-2xl font-bold tracking-tight text-zinc-100">Latest posts</h2>
			<a href="/blog" class="text-sm font-medium text-blue-400 hover:text-blue-300 transition-colors">See all posts →</a>
		</div>
		<div class="mt-8 space-y-6">
			<div class="flex flex-col sm:flex-row sm:items-baseline justify-between group">
				<a href="/blog/7" class="text-zinc-100 font-medium group-hover:text-blue-400 transition-colors">What's inside .git ?</a>
				<span class="text-zinc-500 text-sm mt-1 sm:mt-0">Jan 2026</span>
			</div>
			<div class="flex flex-col sm:flex-row sm:items-baseline justify-between group">
				<a href="/blog/6" class="text-zinc-100 font-medium group-hover:text-blue-400 transition-colors">GSoC - coding period begins</a>
				<span class="text-zinc-500 text-sm mt-1 sm:mt-0">Jun 2023</span>
			</div>
			<div class="flex flex-col sm:flex-row sm:items-baseline justify-between group">
				<a href="/blog/5" class="text-zinc-100 font-medium group-hover:text-blue-400 transition-colors">git init GSoC</a>
				<span class="text-zinc-500 text-sm mt-1 sm:mt-0">May 2023</span>
			</div>
		</div>
	</section>
</Layout>
