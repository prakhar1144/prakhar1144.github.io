---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/300.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark">
		<title>Prakhar Pratyush</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 transition-colors duration-300">
		<div class="max-w-screen-md mx-auto px-6">
			<!-- Navbar -->
			<nav class="lg:flex lg:justify-between lg:items-center py-8 lg:pt-14 lg:pb-12">
				<h1 class="text-3xl lg:text-4xl text-center lg:text-left font-bold tracking-tight">
					<a href="/" class="text-zinc-100 hover:text-blue-400 transition-colors">Prakhar Pratyush</a>
				</h1>
				<div class="mt-6 lg:mt-0 flex justify-center space-x-6 text-[0.95rem] font-medium">
					<a href="/" class="text-zinc-400 hover:text-zinc-100 transition-colors">Home</a>
					<a href="/work" class="text-zinc-400 hover:text-zinc-100 transition-colors">Work</a>
					<a href="/blog" class="text-zinc-400 hover:text-zinc-100 transition-colors">Blog</a>
					<a href="https://github.com/prakhar1144" target="_blank" class="text-zinc-400 hover:text-zinc-100 transition-colors">GitHub</a>
				</div>
			</nav>
			<main class="min-h-[60vh]">
				<slot />
			</main>
			<!-- Footer -->
			<footer class="mt-10 mb-10 py-8 border-t border-zinc-800 text-center text-sm text-zinc-500">
				© {new Date().getFullYear()} Prakhar Pratyush
			</footer>
		</div>

		<!-- Cloudflare Web Analytics -->
		<script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "50d6b3f6f4be42f989cc84d0c33c4a20"}'></script>
	</body>
</html>
