---
import Layout from "./Layout.astro";
const {frontmatter} = Astro.props;
---
<Layout>
    <div class="mt-8 px-4 lg:px-0">
        <h1 class="lg:pt-5 text-3xl text-center">
            {frontmatter.title}
        </h1>
        <h3 class="mt-3 text-gray-600 text-center">
            {frontmatter.date}
        </h3>
        <div class="mt-8 prose lg:prose-lg prose-a:text-blue-500">
            <slot/>
        </div>
    </div>
</Layout>